# Copy to .env.local for local work. On Hostinger set these in the Node.js
# app's Environment Variables. Never commit real values.

# MySQL (same database the PHP site uses). Leave DB_HOST empty to run on the
# built-in fallback content, like the PHP site does without a database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wef_admin
DB_USER=root
DB_PASS=

# Public site URL (canonical links, Stripe return URLs)
SITE_URL=https://www.worldwideeducationfoundation.org

# Where admin-uploaded files live (default: ./uploads)
UPLOADS_DIR=

# Session secret for the admin login (any long random string)
SESSION_SECRET=

# Admin API (for scripts and Claude). 32+ random characters; leave empty to switch the API off.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_API_KEY=

# Stripe (Donate page)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Constant Contact (newsletter) - see admin -> Newsletter
CC_CLIENT_ID=
CC_CLIENT_SECRET=
CC_REDIRECT_URI=https://www.worldwideeducationfoundation.org/admin/modules/newsletter/callback

# Donate-only host (optional). When set, that host serves only the donate page at "/",
# the thank-you page and the Stripe endpoints; every other address goes to MAIN_SITE_URL.
DONATE_HOST=
MAIN_SITE_URL=https://www.worldwideeducationfoundation.org
# Extra hostnames the site may be served on (canonical links), comma separated
SITE_HOSTS=
# Where logs, sessions and backups live (default: ./storage)
STORAGE_DIR=
