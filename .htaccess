# LOCAL DEVELOPMENT ONLY - this file is not part of the upload.
#
# The repository holds two folders:
#   website/  the site; its contents are what goes into Hostinger's public_html
#   extras/   docs, tools, notes and old backups - never uploaded
#
# Under XAMPP the repository is reached at http://localhost/WEF/. This forwards
# every request into website/, where website/.htaccess takes over exactly as it
# does on Hostinger, so http://localhost/WEF/our-team behaves like the live
# /our-team. Older local links such as /WEF/public/... keep working too:
# website/ contains public/, so they forward to website/public/....
#
# Nothing outside website/ is served: extras/, .git/ and the rest are forwarded
# into website/, where they do not exist, and answer 404.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?!website/)(.*)$ website/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</IfModule>
